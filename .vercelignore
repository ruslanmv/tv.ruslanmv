# --- Ignore heavy / non-Vercel parts ---
# backend/ - REMOVED: Vercel needs access to backend for FastAPI
scripts/
database/
mcp-server/
.docker/

# IMPORTANT: Allow FastAPI entrypoint and backend
!api/
!backend/
!requirements.txt

# Ignore Python project config (use requirements.txt instead)
pyproject.toml
poetry.lock

# Still ignore some Python build artifacts at root
# *.py - REMOVED: Vercel needs api/index.py
*.pyc
__pycache__/
.pytest_cache/
.coverage
htmlcov/

# Node build artifacts
dist/
build/
*.egg-info/

# Secrets
.env
.env.local

# Docker / misc
docker-compose*.yml
Dockerfile*

# Docs
*.md

# --- Keep frontend and root config ---
!frontend/**
!vercel.json
