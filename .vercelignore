# --- Ignore heavy / non-Vercel parts ---
backend/
scripts/
database/
mcp-server/
.docker/

# IMPORTANT: Prevent Vercel from detecting this as a Python/FastAPI project
# The FastAPI backend is deployed separately (Docker/other platform)
# Vercel should ONLY deploy the Next.js frontend
pyproject.toml
poetry.lock
requirements*.txt

# Ignore all Python files - Vercel is frontend-only
*.py
*.pyc
__pycache__/
.pytest_cache/
.coverage
htmlcov/

# Node build artifacts
dist/
build/
*.egg-info/

# Secrets
.env
.env.local

# Docker / misc
docker-compose*.yml
Dockerfile*

# Docs
*.md

# --- Keep frontend and root config ---
!frontend/**
!vercel.json
